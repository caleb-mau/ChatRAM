{
  "manifest_version": 3,
  "name": "ChatRAM",
  "short_name": "ChatRAM",
  "version": "0.6.1",
  "description": "Reduce ChatGPT memory use, export conversation handoffs, and automate optional per-tab follow-ups.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/handoff-main.js",
        "src/main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/automation-content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "ChatRAM",
    "default_popup": "src/popup.html"
  },
  "homepage_url": "https://github.com/caleb-mau/ChatRAM",
  "background": {
    "service_worker": "src/automation-background.js"
  }
}
