{
  "manifest_version": 3,
  "name": "ChatRAM",
  "short_name": "ChatRAM",
  "version": "0.4.0",
  "description": "Cuts memory use in long ChatGPT conversations by keeping only a recent history window live in the tab.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["src/main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "ChatRAM",
    "default_popup": "src/popup.html"
  },
  "homepage_url": "https://github.com/calebthecm/ChatRAM"
}
