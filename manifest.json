{
  "manifest_version": 3,
  "name": "ChatGPT Speed-Up",
  "version": "0.2.0",
  "description": "Keeps long ChatGPT conversations fast by limiting how much conversation history the web app holds in memory.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["src/main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "ChatGPT Speed-Up",
    "default_popup": "src/popup.html"
  }
}
